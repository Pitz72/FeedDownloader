{
  "name": "runtime-feeddownloader-pro",
  "private": true,
  "version": "1.3.11",
  "description": "Professional podcast archiving tool — batch download, network resilience, SHA-256 integrity",
  "author": {
    "name": "Simone Pizzi",
    "email": "info@runtimeradio.it"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && tsc && tsc -p tsconfig.electron.json && vite build && electron-builder --publish never",
    "release": "npm run lint && tsc && tsc -p tsconfig.electron.json && vite build && electron-builder --publish always",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist",
    "dist-electron",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "./",
      "to": "./",
      "filter": [
        "README_*.md"
      ]
    }
  ],
  "engines": {
    "node": ">=18.15.0"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "^5.2.38",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/epilogue": "^5.2.8",
    "axios": "^1.13.5",
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.17",
    "electron-updater": "^6.8.3",
    "fast-xml-parser": "^5.3.5",
    "framer-motion": "^12.34.0",
    "fs-extra": "^11.3.3",
    "i18next": "^25.8.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "music-metadata": "^11.12.3",
    "node-id3": "^0.2.9",
    "p-queue": "^9.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.1",
    "rss-parser": "^3.13.0",
    "sanitize-filename": "^1.6.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.0",
    "@vivliostyle/cli": "^10.3.1",
    "autoprefixer": "^10.4.24",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.0"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.runtime.feeddownloader.pro",
    "productName": "Runtime FeedDownloader Pro",
    "directories": {
      "output": "builds/${version}"
    },
    "artifactName": "Runtime-FeedDownloader-Pro-${version}.${ext}",
    "files": [
      "dist",
      "dist-electron",
      "node_modules",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "./",
        "to": "./",
        "filter": [
          "README_*.md"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Ecosystem-Runtime",
      "repo": "FeedDownloader-Releases",
      "releaseType": "release"
    }
  }
}
