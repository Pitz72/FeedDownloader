{
  "name": "runtime-feeddownloader-pro",
  "private": true,
  "version": "1.5.0",
  "description": "Professional podcast archiving tool — batch download, network resilience, SHA-256 integrity",
  "author": {
    "name": "Simone Pizzi",
    "email": "info@runtimeradio.it"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pitz72/FeedDownloader.git"
  },
  "homepage": "https://github.com/Pitz72/FeedDownloader",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run rebuild:electron",
    "clean:electron": "node -e \"require('node:fs').rmSync('dist-electron',{recursive:true,force:true})\"",
    "build": "npm run lint && tsc && tsc -p tsconfig.electron.json && npm run clean:electron && vite build && electron-builder --publish never",
    "release": "npm run lint && tsc && tsc -p tsconfig.electron.json && npm run clean:electron && vite build && electron-builder --publish always",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "pretest": "npm run rebuild:node",
    "posttest": "npm run rebuild:electron",
    "test:watch": "vitest",
    "pretest:watch": "npm run rebuild:node",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "npm run rebuild:node",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3"
  },
  "engines": {
    "node": ">=18.15.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@fontsource-variable/material-symbols-outlined": "^5.2.38",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/epilogue": "^5.2.8",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vivliostyle/cli": "^10.3.1",
    "autoprefixer": "^10.4.24",
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.17",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fast-xml-parser": "^5.3.5",
    "framer-motion": "^12.34.0",
    "fs-extra": "^11.3.3",
    "globals": "^17.11.0",
    "i18next": "^25.8.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "music-metadata": "^11.12.3",
    "node-id3": "^0.2.9",
    "p-queue": "^9.1.0",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.1",
    "rss-parser": "^3.13.0",
    "sanitize-filename": "^1.6.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.0",
    "zustand": "^5.0.11"
  },
  "main": "dist-electron/main.js"
}
